# OpenAI — powers initial UI generation and optimization reasoning (server-side only).
OPENAI_API_KEY=
# Optional model override (default: gpt-5.5).
OPENAI_MODEL=
# Fallback switch: "live" (default) calls OpenAI and falls back to recordings on failure;
# "recorded" always replays the recorded, validated responses (labelled in the UI).
FLOW_AI_MODE=live

# Sentry — Session Replay + Tracing (+ Logs). The dashboard works without these.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
# Optional: deep links to traces/replays in the evidence panel, and source-map upload.
NEXT_PUBLIC_SENTRY_ORG=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Local SQLite database (default: .flow/flow.db).
FLOW_DB_PATH=

# Optional parallel analytics service. Leave disabled until Tiger is configured.
FLOW_ANALYTICS_ENABLED=0
# Use "simulated" only with a fresh, separate FLOW_DB_PATH for the aggregate replay.
FLOW_ANALYTICS_SAMPLE_KIND=live
TIGER_DATABASE_URL=
# Optional absolute path to a trusted provider CA for private/bootstrap certificates.
TIGER_SSL_ROOT_CERT=
# Generate a random 32+ character token locally. The app and analytics service share it.
FLOW_ANALYTICS_TOKEN=
FLOW_APP_URL=http://127.0.0.1:3000
FLOW_ANALYTICS_PORT=4319
FLOW_ANALYTICS_POLL_MS=1500
