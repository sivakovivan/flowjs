# BackBoard — model routing, structured output and decision memory (server-side only).
# When set, BackBoard is the AI provider. https://app.backboard.io → Settings → API Keys
BACKBOARD_API_KEY=
# Optional: "rules" (default, flow.js picks the tier) or "openrouter-auto" (OpenRouter picks within a cost tier).
BACKBOARD_ROUTING=
# Optional tier overrides as provider/model (defaults: openai/gpt-5.6-luna, openai/gpt-5.6-sol, anthropic/claude-sonnet-5).
BACKBOARD_MODEL_FAST=
BACKBOARD_MODEL_BALANCED=
BACKBOARD_MODEL_DEEP=
# Optional: force a provider when both keys are set ("backboard" or "openai").
FLOW_AI_PROVIDER=

# OpenAI direct — used only when BackBoard is not configured.
OPENAI_API_KEY=
# Optional model override (default: gpt-5.5).
OPENAI_MODEL=
# Fallback switch: "live" (default) calls the AI provider and falls back to recordings on failure;
# "recorded" always replays the recorded, validated responses (labelled in the UI) and makes no network calls.
FLOW_AI_MODE=live

# Sentry — Session Replay + Tracing (+ Logs). The dashboard works without these.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
# Optional: deep links to traces/replays in the evidence panel, and source-map upload.
NEXT_PUBLIC_SENTRY_ORG=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Local SQLite database (default: .flow/flow.db).
FLOW_DB_PATH=
