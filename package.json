{
    "name": "@flowjs/core",
    "version": "0.1.0",
    "private": true,
    "description": "flow.js — an adaptive interface runtime that turns application capabilities into continuously evolving user interfaces.",
    "type": "module",
    "exports": {
        "./flow/ai/*": "./src/flow/ai/*.ts",
        "./flow/*": "./src/flow/*.ts",
        "./client/*": "./src/client/*.ts",
        "./server/capabilities": "./src/server/capabilities.ts",
        "./server/http": "./src/server/http.ts",
        "./components/studio/FlowStudio": "./src/components/studio/FlowStudio.tsx",
        "./components/renderer/Dashboard": "./src/components/renderer/Dashboard.tsx"
    },
    "engines": {
        "node": ">=24"
    },
    "scripts": {
        "dev": "pnpm --dir apps/demo dev",
        "build": "pnpm --dir apps/demo build",
        "start": "pnpm --dir apps/demo start",
        "typecheck": "tsc --noEmit",
        "format": "prettier --write .",
        "format:check": "prettier --check README.md apps/demo/src/app/api/flow/generate/route.ts apps/demo/src/app/developer/page.tsx apps/demo/src/app/globals.css apps/demo/src/demo/operations-app.test.ts apps/demo/src/demo/operations-app.ts apps/demo/src/instrumentation-client.ts apps/demo/src/instrumentation.ts src/client/api.ts src/components/renderer/Dashboard.tsx src/components/studio/CustomizationChat.tsx src/components/studio/FlowStudio.tsx src/flow/ai/briefs.ts src/flow/metrics.ts src/flow/runtime.test.ts src/flow/runtime.ts src/flow/store.ts package.json",
        "test": "vitest run",
        "test:watch": "vitest",
        "db:reset": "node scripts/db-reset.mjs",
        "test:e2e": "pnpm --dir apps/demo test:e2e"
    },
    "dependencies": {
        "@samasante/liquid-glass": "0.1.1",
        "@sentry/nextjs": "^10.75.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "lucide-react": "^1.47.0",
        "motion": "^13.4.0",
        "next": "^16.3.5",
        "openai": "^7.19.0",
        "radix-ui": "^1.6.7",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "recharts": "^3.10.1",
        "tailwind-merge": "^3.7.0",
        "zod": "^4.6.5"
    },
    "devDependencies": {
        "@playwright/test": "^1.63.0",
        "@types/node": "^24.13.5",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "prettier": "3.9.8",
        "typescript": "^5.9.3",
        "vitest": "^5.0.1"
    }
}
