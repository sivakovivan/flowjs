{
    "name": "flowjs",
    "version": "0.1.0",
    "private": true,
    "description": "flow.js — an adaptive interface runtime that turns application capabilities into continuously evolving user interfaces.",
    "type": "module",
    "engines": {
        "node": ">=24"
    },
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "typecheck": "tsc --noEmit",
        "format": "prettier --write .",
        "format:check": "prettier --check package.json src/app/developer/page.tsx src/app/globals.css src/components/studio/CustomizationChat.tsx src/components/studio/FlowStudio.tsx",
        "test": "vitest run",
        "test:watch": "vitest",
        "db:reset": "node scripts/db-reset.mjs",
        "test:e2e": "playwright test"
    },
    "dependencies": {
        "@sentry/nextjs": "^10.75.0",
        "motion": "^13.4.0",
        "next": "^16.3.5",
        "openai": "^7.19.0",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "recharts": "^3.10.1",
        "zod": "^4.6.5"
    },
    "devDependencies": {
        "@playwright/test": "^1.63.0",
        "@types/node": "^24.13.5",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "prettier": "3.9.8",
        "typescript": "^5.9.3",
        "vitest": "^5.0.1"
    }
}
