# AI provider — set to "openai" by default, or "backboard" for a compatible API.
AI_PROVIDER=openai

# OpenAI — powers initial UI generation and optimization reasoning (server-side only).
OPENAI_API_KEY=
# Optional model override (default: gpt-5.5).
OPENAI_MODEL=

# Backboard-compatible OpenAI endpoint (optional; used when AI_PROVIDER=backboard).
BACKBOARD_API_KEY=
BACKBOARD_BASE_URL=
BACKBOARD_API_URL=
BACKBOARD_MODEL=

# Fallback switch: "live" (default) calls the configured provider and falls back to recordings on failure;
# "recorded" always replays the recorded, validated responses (labelled in the UI).
FLOW_AI_MODE=live

# Sentry — Session Replay + Tracing (+ Logs). The dashboard works without these.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
# Optional: deep links to traces/replays in the evidence panel, and source-map upload.
NEXT_PUBLIC_SENTRY_ORG=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Local SQLite database (default: .flow/flow.db).
FLOW_DB_PATH=
